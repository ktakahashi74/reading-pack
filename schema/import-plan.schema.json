{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/import-plan.schema.json",
  "title": "Reading Pack body-free import plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "source",
    "metadata_candidates",
    "units",
    "diagnostics",
    "outcome"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^IP-[0-9A-F]{20}$"},
    "source": {"$ref": "#/$defs/source"},
    "metadata_candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/metadataCandidate"}
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/unit"}
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 20000,
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "outcome": {"enum": ["ready", "review_required", "blocked"]}
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "sha256", "size_bytes", "format"],
      "properties": {
        "id": {"const": "SRC-1"},
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "format": {"enum": ["markdown", "org", "epub3", "pdf", "pdf-vertical", "text"]}
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["high", "medium", "low", "conflict"]},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_id", "source_sha256", "method"],
      "properties": {
        "source_id": {"const": "SRC-1"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "method": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    },
    "metadataCandidate": {
      "type": "object",
      "required": ["field", "value", "decision", "extraction_confidence", "provenance"],
      "properties": {
        "field": {"enum": ["title", "author", "publisher", "isbn"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 500},
        "decision": {"enum": ["unresolved", "accepted", "rejected"]},
        "extraction_confidence": {"$ref": "#/$defs/confidence"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/provenance"}
        }
      },
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "required": ["scheme", "start"],
      "properties": {
        "scheme": {"enum": ["document", "outline-order", "printed-page"]},
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": [
        "staging_id",
        "kind",
        "parent_id",
        "order",
        "title",
        "source_key",
        "locators",
        "extraction_confidence",
        "provenance"
      ],
      "properties": {
        "staging_id": {"type": "string", "pattern": "^U-[0-9A-F]{20}$"},
        "kind": {
          "enum": [
            "book", "frontmatter", "part", "chapter", "section", "afterword",
            "appendix", "notes", "bibliography", "glossary", "index", "colophon", "unknown"
          ]
        },
        "parent_id": {"type": ["string", "null"]},
        "order": {"type": "integer", "minimum": 0},
        "title": {"type": "string", "maxLength": 500},
        "source_key": {"type": "string", "maxLength": 100},
        "locators": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/locator"}
        },
        "extraction_confidence": {"$ref": "#/$defs/confidence"},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/provenance"}
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^RPIP[0-9]{3}$"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000},
        "unit_id": {"type": "string", "pattern": "^U-[0-9A-F]{20}$"}
      },
      "additionalProperties": false
    }
  }
}
