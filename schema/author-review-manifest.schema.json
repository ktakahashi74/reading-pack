{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/author-review-manifest.schema.json",
  "title": "Private hash-bound author review evidence manifest",
  "type": "object",
  "required": [
    "schema_version", "review_id", "created_at", "slug", "version",
    "primary_language", "languages", "snapshot", "records"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "review_id": {"type": "string", "pattern": "^AR-[A-F0-9]{20}$"},
    "created_at": {"type": "string", "format": "date"},
    "slug": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "primary_language": {"enum": ["ja", "en"]},
    "languages": {
      "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["ja", "en"]}
    },
    "modules": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["chapters", "certainty", "claims", "qa", "policy", "names", "glossary", "references"]}
    },
    "record_ids": {
      "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "release_signoff": {"const": true},
    "snapshot": {
      "type": "object",
      "required": [
        "canonical_state_sha256", "canonical_data_sha256", "config_sha256",
        "quality_plan_sha256", "author_review_state_sha256", "template_sha256"
      ],
      "properties": {
        "canonical_state_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_data_sha256": {"$ref": "#/$defs/sha256"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "quality_plan_sha256": {"$ref": "#/$defs/sha256"},
        "author_review_state_sha256": {"$ref": "#/$defs/sha256"},
        "template_sha256": {
          "type": "object",
          "propertyNames": {"enum": ["ja", "en"]},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array", "maxItems": 100000,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record": {
      "type": "object",
      "required": [
        "unit_id", "language", "collection", "module", "module_state_sha256",
        "record_id", "record_sha256", "semantic_sha256", "status",
        "translation_status", "editable_fields"
      ],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^ARU-[0-9]{6}$"},
        "language": {"enum": ["ja", "en"]},
        "collection": {"enum": ["chapters", "certainty", "claims", "misreadings", "policies", "names", "glossary", "references"]},
        "module": {"enum": ["chapters", "certainty", "claims", "qa", "policy", "names", "glossary", "references"]},
        "module_state_sha256": {"$ref": "#/$defs/sha256"},
        "record_id": {"type": "string", "minLength": 1},
        "record_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["draft", "reviewed", "approved"]},
        "translation_status": {"enum": [null, "draft", "reviewed", "approved"]},
        "editable_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
