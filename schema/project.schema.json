{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/project.schema.json",
  "title": "Reading Pack project configuration",
  "description": "JSON representation of reading-pack.toml. The CLI validates the TOML directly.",
  "type": "object",
  "required": [
    "format_version",
    "slug",
    "version",
    "pack_date",
    "status",
    "primary_language",
    "languages",
    "level",
    "book",
    "workflow",
    "limits"
  ],
  "properties": {
    "format_version": {"const": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "minLength": 1},
    "pack_date": {"type": "string", "format": "date"},
    "status": {"enum": ["draft", "beta", "canonical", "retired"]},
    "primary_language": {"enum": ["ja", "en"]},
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ja", "en"]}
    },
    "level": {"enum": [1, 2, 3]},
    "output_basename": {"type": "string", "minLength": 1},
    "book": {
      "type": "object",
      "required": ["title", "author", "copyright_holder", "copyright_year", "pack_license"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "publisher": {"type": "string"},
        "publication_date": {"type": "string"},
        "isbn": {"type": "string"},
        "official_url": {"type": "string"},
        "contents_note": {"type": "string"},
        "copyright_holder": {"type": "string", "minLength": 1},
        "copyright_year": {"type": "integer", "minimum": 1000},
        "pack_license": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "design_constraints",
        "rights_review",
        "author_review",
        "publisher_review",
        "reconstruction_review",
        "publication_decision"
      ],
      "additionalProperties": {"$ref": "#/$defs/reviewState"}
    },
    "limits": {
      "type": "object",
      "required": ["max_summary_characters", "max_pack_characters"],
      "properties": {
        "max_summary_characters": {"type": "integer", "minimum": 1},
        "max_pack_characters": {"type": "integer", "minimum": 1000}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "reviewState": {
      "enum": ["pending", "draft", "reviewed", "approved", "not_required"]
    }
  },
  "additionalProperties": false
}
