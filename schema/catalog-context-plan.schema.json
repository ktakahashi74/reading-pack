{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/catalog-context-plan.schema.json",
  "title": "Reading Pack catalog context work plan",
  "description": "Excerpt-free, source- and canonical-bound targets for explaining how the book treats retained people and terms.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "language",
    "source",
    "text_sha256",
    "canonical_data_sha256",
    "catalog_inventory_id",
    "catalog_integrity_sha256",
    "chapter_spans",
    "targets",
    "summary",
    "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^CTX-[A-F0-9]{20}$"},
    "language": {"enum": ["ja", "en"]},
    "source": {"$ref": "catalog-inventory.schema.json#/$defs/source"},
    "text_sha256": {"$ref": "catalog-inventory.schema.json#/$defs/sha256"},
    "canonical_data_sha256": {"$ref": "catalog-inventory.schema.json#/$defs/sha256"},
    "catalog_inventory_id": {"type": "string", "pattern": "^CAT-[A-F0-9]{20}$"},
    "catalog_integrity_sha256": {"$ref": "catalog-inventory.schema.json#/$defs/sha256"},
    "chapter_spans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {"$ref": "catalog-inventory.schema.json#/$defs/chapterSpan"}
    },
    "targets": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/target"}
    },
    "summary": {
      "type": "object",
      "required": ["total", "names", "glossary"],
      "properties": {
        "total": {"type": "integer", "minimum": 0, "maximum": 2000},
        "names": {"type": "integer", "minimum": 0, "maximum": 2000},
        "glossary": {"type": "integer", "minimum": 0, "maximum": 2000}
      },
      "additionalProperties": false
    },
    "integrity_sha256": {"$ref": "catalog-inventory.schema.json#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "target": {
      "type": "object",
      "required": [
        "collection",
        "record_id",
        "value",
        "chapter_id",
        "context_field",
        "base_record_sha256"
      ],
      "properties": {
        "collection": {"enum": ["names", "glossary"]},
        "record_id": {"type": "string", "pattern": "^(?:NAME|TERM)-[A-Z0-9][A-Z0-9.-]*$"},
        "value": {"type": "string", "minLength": 1, "maxLength": 200},
        "chapter_id": {"$ref": "catalog-inventory.schema.json#/$defs/chapterId"},
        "context_field": {"enum": ["book_context", "book_meaning"]},
        "base_record_sha256": {"$ref": "catalog-inventory.schema.json#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
