{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/author-input-manifest.schema.json",
  "title": "Reading Pack Author Input Package manifest",
  "type": "object",
  "required": ["schema_version", "package_id", "language", "authority", "modules", "attachments"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"type": "string", "pattern": "^AIP-[A-Z0-9][A-Z0-9.-]{0,99}$"},
    "language": {"enum": ["ja", "en"]},
    "authority": {"$ref": "#/$defs/authority"},
    "modules": {
      "type": "object",
      "required": ["chapters", "summaries", "chapter_terms", "certainty", "claims", "qa", "names", "glossary", "references"],
      "properties": {
        "chapters": {"$ref": "#/$defs/chapterModule"},
        "summaries": {"$ref": "#/$defs/module"},
        "chapter_terms": {"$ref": "#/$defs/module"},
        "certainty": {"$ref": "#/$defs/module"},
        "claims": {"$ref": "#/$defs/module"},
        "qa": {"$ref": "#/$defs/module"},
        "policy": {"$ref": "#/$defs/module"},
        "names": {"$ref": "#/$defs/module"},
        "glossary": {"$ref": "#/$defs/module"},
        "references": {"$ref": "#/$defs/module"}
      },
      "additionalProperties": false
    },
    "attachments": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/attachment"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "authority": {
      "type": "object",
      "required": ["type", "name", "supplied_at"],
      "properties": {
        "type": {"enum": ["author", "editor", "publisher", "rights-holder"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "supplied_at": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    },
    "module": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["generate", "omit"]}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "file", "format", "source_id"],
          "properties": {
            "mode": {"enum": ["provided", "augment"]},
            "file": {"type": "string", "minLength": 1, "maxLength": 500},
            "format": {"enum": ["json", "csv"]},
            "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9.-]{0,99}$"},
            "role": {"enum": ["author-qa", "author-canon", "author-data", "errata", "bibliography", "publisher-metadata", "translation"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "chapterModule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "generate"}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "file", "format", "source_id"],
          "properties": {
            "mode": {"enum": ["provided", "augment"]},
            "file": {"type": "string", "minLength": 1, "maxLength": 500},
            "format": {"enum": ["json", "csv"]},
            "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9.-]{0,99}$"},
            "role": {"enum": ["author-qa", "author-canon", "author-data", "errata", "bibliography", "publisher-metadata", "translation"]}
          },
          "additionalProperties": false
        }
      ]
    },
    "attachment": {
      "type": "object",
      "required": ["source_id", "role", "language", "format", "file"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9.-]{0,99}$"},
        "role": {"enum": ["author-qa", "author-canon", "author-data", "errata", "bibliography", "publisher-metadata", "translation"]},
        "language": {"enum": ["ja", "en", "und"]},
        "format": {"enum": ["markdown", "org", "json", "csv", "epub3", "pdf", "pdf-vertical", "text"]},
        "file": {"type": "string", "minLength": 1, "maxLength": 500}
      },
      "additionalProperties": false
    }
  }
}
