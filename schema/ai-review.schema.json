{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/ai-review.schema.json",
  "title": "Reading Pack excerpt-free AI candidate review",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_integrity_sha256",
    "reviewer",
    "decisions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "run_integrity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "required": ["type", "name", "method", "reviewed_at"],
      "properties": {
        "type": {"const": "ai"},
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "method": {"type": "string", "minLength": 1, "maxLength": 500},
        "reviewed_at": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "record_sha256",
          "candidate_artifact_sha256",
          "decision",
          "checks"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^CAND-[A-F0-9]{20}$"
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "candidate_artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decision": {"enum": ["accept", "reject"]},
          "checks": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "source_support",
                "semantic_fidelity",
                "scope_and_qualification"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
