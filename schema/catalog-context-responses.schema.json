{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/catalog-context-responses.schema.json",
  "title": "Reading Pack catalog context responses",
  "description": "Complete transient descriptions for one catalog context plan. The CLI additionally verifies target completeness, canonical freshness, source spans, chapter boundaries, and target occurrence.",
  "type": "object",
  "required": ["plan_id", "candidates"],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^CTX-[A-F0-9]{20}$"},
    "candidates": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["record_id", "description", "evidence"],
        "properties": {
          "record_id": {"type": "string", "pattern": "^(?:NAME|TERM)-[A-Z0-9][A-Z0-9.-]*$"},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["snippet", "supports_field"],
              "properties": {
                "snippet": {"type": "string", "minLength": 8, "maxLength": 500},
                "occurrence": {"type": "integer", "minimum": 0, "maximum": 10000},
                "supports_field": {"enum": ["book_context", "book_meaning"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
