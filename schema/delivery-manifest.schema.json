{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-manifest.schema.json",
  "title": "Reading Pack Web Delivery manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "pack",
    "entry_prompt",
    "bootstrap",
    "modules",
    "coverage"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveBytes": {
      "type": "integer",
      "minimum": 1
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "of",
        "records",
        "first_id",
        "last_id",
        "payload_sha256",
        "payload_bytes",
        "sha256",
        "bytes",
        "url"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "of": { "type": "integer", "minimum": 1 },
        "records": { "type": "integer", "minimum": 0 },
        "first_id": { "type": ["string", "null"], "minLength": 1 },
        "last_id": { "type": ["string", "null"], "minLength": 1 },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "payload_bytes": { "$ref": "#/$defs/positiveBytes" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positiveBytes" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "const": "web-lazy-v1" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "version", "language", "sha256", "bytes", "url"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "language": { "enum": ["ja", "en"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positiveBytes" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "entry_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "source"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positiveBytes" },
        "source": { "const": "entry-prompt.txt" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "url"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "$ref": "#/$defs/positiveBytes" },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "records", "section_sha256", "section_bytes", "parts"],
        "properties": {
          "id": { "enum": ["MAP", "CERT", "PROPS", "MIS", "POLICY", "NAMES", "GLOSS", "REF", "META"] },
          "records": { "type": "integer", "minimum": 0 },
          "section_sha256": { "$ref": "#/$defs/sha256" },
          "section_bytes": { "$ref": "#/$defs/positiveBytes" },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/part" }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "entry_prompt_rule_ids"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "mode", "targets"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "mode": { "enum": ["exact", "projected"] },
              "targets": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "entry_prompt_rule_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
