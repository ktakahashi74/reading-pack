{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/reading-pack/provenance-receipt.schema.json",
  "title": "Reading Pack sequential applied-run provenance receipt",
  "type": "object",
  "required": [
    "schema_version", "receipt_id", "project", "language", "canonical",
    "continuity", "runs", "integrity_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "pattern": "^PR-[A-F0-9]{20}$"},
    "project": {
      "type": "object",
      "required": ["slug", "config_sha256"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "language": {"enum": ["ja", "en"]},
    "canonical": {"$ref": "#/$defs/canonical"},
    "continuity": {
      "type": "object",
      "required": ["status", "verified_links", "total_links"],
      "properties": {
        "status": {"enum": ["verified", "legacy_unverified"]},
        "verified_links": {"type": "integer", "minimum": 0},
        "total_links": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "sequence", "run_id", "run_integrity_sha256", "source",
          "canonical_before", "application", "summary",
          "applied_candidate_ids_sha256", "rejected_candidate_ids_sha256",
          "review_artifact_sha256s"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
          "run_integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source": {"$ref": "#/$defs/source"},
          "canonical_before": {"$ref": "#/$defs/canonical"},
          "application": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/application"}
            ]
          },
          "summary": {
            "type": "object",
            "required": ["total", "applied", "rejected"],
            "properties": {
              "total": {"type": "integer", "minimum": 1},
              "applied": {"type": "integer", "minimum": 1},
              "rejected": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "applied_candidate_ids_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "rejected_candidate_ids_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "review_artifact_sha256s": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "additionalProperties": false
      }
    },
    "integrity_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "canonical": {
      "type": "object",
      "required": ["data_sha256", "project_data_sha256"],
      "properties": {
        "data_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "project_data_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["name", "format", "sha256", "text_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9.-]{0,99}$"},
        "role": {"type": "string", "minLength": 1, "maxLength": 100},
        "name": {"type": "string", "minLength": 1, "maxLength": 500},
        "format": {"type": "string", "minLength": 1, "maxLength": 50},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "dependentRequired": {"id": ["role"], "role": ["id"]},
      "additionalProperties": false
    },
    "application": {
      "type": "object",
      "required": [
        "application_id", "before_sha256", "after_sha256",
        "before_project_sha256", "after_project_sha256", "candidate_ids"
      ],
      "properties": {
        "application_id": {"type": "string", "pattern": "^APP-[A-F0-9]{20}$"},
        "before_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "after_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "before_project_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "after_project_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CAND-[A-F0-9]{20}$"}
        }
      },
      "additionalProperties": false
    }
  }
}
